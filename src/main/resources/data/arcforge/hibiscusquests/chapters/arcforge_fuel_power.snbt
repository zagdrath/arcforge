        },
        {
            id: "diesel_generator",
            title: "Diesel Generator",
            icon: "arcforge:diesel_generator_controller",
            description: [
                "A 3×3 box 5, 7 or 9 long: a V8, V12 or V16 making 3,000, 8,000 or 15,000 FE/t on Diesel, Gasoline, Kerosene, Biodiesel or Refinery Gas. Loud, simple, and it starts instantly."
            ],
            x: 1.5d,
            y: 1.25d,
            shape: "hexagon",
            size: 1.5d,
            dependencies: ["diesel_parts"],
            tasks: [
                {
                    type: "criterion",
