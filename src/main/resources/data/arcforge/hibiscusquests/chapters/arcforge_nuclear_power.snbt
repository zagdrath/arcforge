                        }
                    },
                    title: "Form the Heavy Water Tower",
                    icon: "arcforge:heavy_water_tower_controller"
                },
                {
                    type: "item",
                    item: "arcforge:heavy_water_bucket"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:pvc_sheet",
                    count: 8
                },
                {
                    type: "xp_levels",
                    levels: 12
                }
            ]
        },
        {
            id: "nuclear_turbine",
            title: "Nuclear Steam Turbine",
            icon: "arcforge:nuclear_turbine_casing",
            description: [
                "A reactor makes far more steam than a Steam Turbine Array takes. The Nuclear Steam Turbine is built for it: a 7x7 tube of Nuclear Turbine Casings 21 to 45 long, on High-Pressure Steam only, at up to 240 mB/t a section. It trips under a quarter of its rated flow, so give it a reactor's steam and send its exhaust to Condenser Arrays.",
                "",
                "**Covers:** {item:arcforge:nuclear_turbine_casing}"
            ],
            x: 7.5d,
            y: 2.5d,
            dependencies: ["steam_generator"],
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "arcforge:multiblock_formed",
                        conditions: {
                            multiblock: "arcforge:nuclear_steam_turbine"
                        }
                    },
                    title: "Form the Nuclear Steam Turbine",
                    icon: "arcforge:nuclear_turbine_casing"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:hardened_alloy",
                    count: 8
                },
                {
                    type: "xp_levels",
                    levels: 15
                }
            ]
        },
        {
            id: "power_plant",
            title: "Power Plant",
            icon: "arcforge:nuclear_turbine_casing",
            description: [
                "Fission Reactor, Steam Generator and a Nuclear Steam Turbine at its synchronous speed: a nuclear power station. A medium core drives one turbine, a large one two."
            ],
            x: 9d,
            y: 2.5d,
            shape: "gear",
