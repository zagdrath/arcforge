                    count: 16
                },
                {
                    type: "xp_levels",
                    levels: 10
                }
            ]
        },
        {
            id: "fission_reactor",
            title: "Fission Reactor",
            icon: "arcforge:reactor_controller",
            description: [
                "Build the vessel round a grid of channels, set its ports with the Wrench and form it. Load fuel and control rods, fill it with water, and pull the rods out slowly: watch k-effective and the period. The Protection System SCRAMs the core if you go too fast.",
                "",
                "**Covers:** {item:arcforge:fuel_channel}, {item:arcforge:control_rod_channel}"
            ],
            x: 6d,
            y: 1.25d,
            shape: "hexagon",
            size: 1.5d,
            dependencies: ["vessel"],
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "arcforge:multiblock_formed",
                        conditions: {
                            multiblock: "arcforge:fission_reactor"
                        }
                    },
                    title: "Form the Fission Reactor",
                    icon: "arcforge:reactor_controller"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:hardened_alloy",
                    count: 8
                },
                {
                    type: "xp_levels",
                    levels: 15
                }
            ]
        },
        {
            id: "steam_generator",
            title: "Steam Generator",
            icon: "arcforge:steam_generator_controller",
            description: [
                "In a pressurized-water reactor the coolant never boils; it carries heat to a Steam Generator, a tall vessel of Steam Generator Tubes (nickel rods and steel plates) that boils feedwater into High-Pressure Steam for your turbines.",
                "",
                "**Covers:** {item:arcforge:steam_generator_casing}, {item:arcforge:steam_generator_controller}, {item:arcforge:steam_generator_tubes}"
            ],
            x: 6d,
            y: 2.5d,
            dependencies: ["vessel", "arcforge_steam/turbine"],
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "arcforge:multiblock_formed",
                        conditions: {
                            multiblock: "arcforge:steam_generator"
                        }
                    },
                    title: "Form the Steam Generator",
                    icon: "arcforge:steam_generator_controller"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:steam_generator_tubes",
                    count: 8
                },
                {
                    type: "xp_levels",
                    levels: 12
                }
            ]
        },
        {
            id: "heavy_water",
            title: "Heavy Water",
            icon: "arcforge:heavy_water_bucket",
            description: [
                "The Heavy Water Tower (casings with PVC, Exchange Trays inside) runs the Girdler sulfide process: water, a little Hydrogen Sulfide and steam give Heavy Water, a moderator that absorbs almost nothing.",
                "",
                "**Covers:** {item:arcforge:heavy_water_tower_casing}, {item:arcforge:heavy_water_tower_controller}, {item:arcforge:exchange_tray}, {item:arcforge:heavy_water_bucket}"
            ],
            x: 6d,
