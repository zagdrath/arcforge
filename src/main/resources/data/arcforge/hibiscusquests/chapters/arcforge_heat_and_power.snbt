{
    id: "arcforge_heat_and_power",
    group: "arcforge_foundations",
    order: 3,
    title: "Heat & Power",
    subtitle: "Fireboxes, heat conduits and generators",
    icon: "arcforge:geothermal_plant",
    default_shape: "circle",
    requires: ["arcforge_getting_started/thermoelectric_plant"],
    quests: [
        {
            id: "geothermal_plant",
            title: "Geothermal Plant",
            icon: "arcforge:geothermal_plant",
            description: [
                "Lava into heat, up to 1,400°C. Fill its 8,000 mB tank with buckets or a pipe (1 mB/t, 80,000 HU a bucket), or just surround it: every touching lava source adds 40 HU/t and every magma block 16 HU/t, forever, free. Five lava sides is 200 HU/t with no fuel and no pumping.",
                "",
                "**Covers:** {item:arcforge:geothermal_plant}"
            ],
            x: 0d,
            y: 1.25d,
            shape: "hexagon",
            size: 1.5d,
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "minecraft:placed_block",
                        conditions: {
                            location: {
                                type: "minecraft:location_check",
                                predicate: {
                                    block: {
                                        blocks: "arcforge:geothermal_plant"
                                    }
                                }
                            }
                        }
                    },
                    title: "Place Geothermal Plant",
                    icon: "arcforge:geothermal_plant"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "minecraft:lava_bucket",
                    count: 2
                },
                {
                    type: "xp_levels",
                    levels: 3
                }
            ]
        },
        {
            id: "thermal_conduits",
            title: "Move the Heat",
            icon: "arcforge:wrought_thermal_conduit",
            description: [
                "Heat only flows from hotter to colder, and a touching machine takes at most 100 HU/t. Thermodynamic Conduits carry more: Wrought 50, Tempered 200, Hardened 800 (Invar Plates), Arcforged 51,200 HU/t. About 25 lava-locked Geothermal Plants on Tempered conduits run a full Steam Turbine Array.",
                "",
                "**Covers:** {item:arcforge:wrought_thermal_conduit}, {item:arcforge:tempered_thermal_conduit}, {item:arcforge:hardened_thermal_conduit}, {item:arcforge:arcforged_thermal_conduit}"
            ],
            x: 1.5d,
            y: 1.25d,
            dependencies: ["geothermal_plant"],
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "minecraft:inventory_changed",
                        conditions: {
                            items: [
                                {
                                    items: [
                                        "arcforge:wrought_thermal_conduit",
                                        "arcforge:tempered_thermal_conduit",
                                        "arcforge:hardened_thermal_conduit",
                                        "arcforge:arcforged_thermal_conduit"
                                    ]
                                }
                            ]
                        }
                    },
                    title: "Obtain Wrought Thermodynamic Conduit or Tempered Thermodynamic Conduit or Hardened Thermodynamic Conduit or Arcforged Thermodynamic Conduit",
                    icon: "arcforge:wrought_thermal_conduit"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:tempered_thermal_conduit",
                    count: 8
                },
                {
                    type: "xp_levels",
                    levels: 3
                }
            ]
        },
        {
            id: "fuel_burner",
            title: "Fuel Burner",
            icon: "arcforge:fuel_burner",
            description: [
                "A Firebox for liquids and gases: each fuel burns at its own temperature and HU per mB. Creosote 850°C, Ethanol 900°C, Biodiesel 1,000°C, Light Oil 1,000°C, Kerosene and Diesel 1,150°C, Naphtha 1,200°C, Gasoline 1,250°C, Hydrogen 1,400°C. Oxygen on an Oxygen face gives oxy-fuel: +300°C and 1.25× the heat.",
                "",
                "**Covers:** {item:arcforge:fuel_burner}"
            ],
            x: 1.5d,
            y: 2.5d,
            dependencies: ["geothermal_plant"],
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "minecraft:placed_block",
                        conditions: {
                            location: {
                                type: "minecraft:location_check",
                                predicate: {
                                    block: {
                                        blocks: "arcforge:fuel_burner"
                                    }
                                }
                            }
                        }
                    },
                    title: "Place Fuel Burner",
                    icon: "arcforge:fuel_burner"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:creosote_bucket",
                    count: 2
                },
                {
                    type: "xp_levels",
                    levels: 3
                }
            ]
        },
        {
            id: "arc_melter",
            title: "Arc Melter",
            icon: "arcforge:arc_melter",
            description: [
                "Tempered Alloy and a heating coil round a blast furnace: cobblestone or stone into 250 mB of lava for 50 FE/mB. Pipe it into a Geothermal Plant when there's no lava lake nearby.",
                "",
                "**Covers:** {item:arcforge:arc_melter}"
            ],
            x: 3d,
            y: 2.5d,
            dependencies: ["fuel_burner"],
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "minecraft:placed_block",
                        conditions: {
                            location: {
                                type: "minecraft:location_check",
                                predicate: {
                                    block: {
                                        blocks: "arcforge:arc_melter"
                                    }
                                }
                            }
                        }
                    },
                    title: "Place Arc Melter",
                    icon: "arcforge:arc_melter"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "minecraft:cobblestone",
                    count: 64
                },
                {
                    type: "xp_levels",
                    levels: 3
                }
            ]
        },
        {
            id: "firebox_array",
            title: "Firebox Array",
            icon: "arcforge:firebox_array_controller",
            description: [
                "A hollow box of Firebox Array Casings, 3 to 7 on a side, with one Controller in a side wall facing out. Its walls, floor and roof may be Pressure Glass. It burns solids, liquids and gases: 3,967 HU/t at 3×3×3, 50,400 HU/t at 7×7×7, exactly what the biggest Steam Boiler Array takes. Coke burns at 1,300°C, Hydrogen at 1,400°C.",
                "",
                "**Covers:** {item:arcforge:firebox_array_casing}, {item:arcforge:firebox_array_controller}"
            ],
            x: 3d,
            y: 3.75d,
            shape: "hexagon",
            size: 1.5d,
            dependencies: ["fuel_burner"],
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "arcforge:multiblock_formed",
                        conditions: {
                            multiblock: "arcforge:firebox_array"
                        }
                    },
                    title: "Form the Firebox Array",
                    icon: "arcforge:firebox_array_controller"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:firebox_array_casing",
                    count: 8
                },
                {
                    type: "xp_levels",
                    levels: 6
                }
            ]
        },
        {
            id: "roaring_inferno",
            title: "Roaring Inferno",
            icon: "arcforge:firebox_array_casing",
            description: ["A full 7×7×7 Firebox Array: 343 blocks, 50,400 HU/t."],
            x: 4.5d,
            y: 3.75d,
            shape: "gear",
            size: 1.5d,
