        {
            id: "heat_upgrades",
            title: "Hotter, Tighter",
            icon: "arcforge:heat_upgrade",
            description: [
                "The Heat Upgrade (blaze powder, magma cream, Steel Plate) gives more heat per fuel or lava and lifts a Thermoelectric Plant's efficiency. The Insulation Upgrade (Rock Wool) slows a Heat Cell's leak.",
                "",
                "**Covers:** {item:arcforge:heat_upgrade}, {item:arcforge:insulation_upgrade}"
            ],
            x: 1.5d,
            y: 0d,
