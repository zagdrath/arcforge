        {
            id: "thermal_capsules",
            title: "Thermal Capsules",
            icon: "arcforge:wrought_thermal_capsule",
            description: [
                "Portable heat: fill a capsule in a Heat Cell's slot and carry it to a Grain Dryer or Vulcanizer out in the fields. 50,000 HU Wrought to 3,200,000 HU Arcforged; it leaks while carried.",
                "",
                "**Covers:** {item:arcforge:wrought_thermal_capsule}, {item:arcforge:tempered_thermal_capsule}, {item:arcforge:hardened_thermal_capsule}, {item:arcforge:arcforged_thermal_capsule}"
            ],
