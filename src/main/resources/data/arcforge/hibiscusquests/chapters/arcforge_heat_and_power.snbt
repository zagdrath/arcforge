        {
            id: "solar_parts",
            title: "Mirrors and Tubes",
            icon: "arcforge:trough_mirror",
            description: [
                "Three glass over three Silver Plates make a Trough Mirror; glass, copper rods, glass a Receiver Tube. Three mirrors, two steel rods and a tube build a Solar Collector.",
                "",
                "**Covers:** {item:arcforge:trough_mirror}, {item:arcforge:receiver_tube}, {item:arcforge:solar_collector}"
            ],
