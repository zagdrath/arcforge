        {
            id: "solar_thermal_array",
            title: "Solar Thermal Array",
            icon: "arcforge:solar_thermal_array_controller",
            description: [
                "A 2×2 tower four tall: three layers of Solar Thermal Array Casings (one is the Controller, in the bottom layer) and four Solar Collectors on top. It tracks the sun along the controller's facing (north–south full, east–west ×0.7) for up to 600 HU/t at 1,100°C at a clear noon. Nothing at night, so pair it with Heat Cells.",
                "",
                "**Covers:** {item:arcforge:solar_thermal_array_casing}, {item:arcforge:solar_thermal_array_controller}"
            ],
            x: 4.5d,
