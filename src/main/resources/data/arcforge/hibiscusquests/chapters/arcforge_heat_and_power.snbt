            title: "White Heat",
            icon: "arcforge:fuel_burner",
            description: ["Oxy-fuel at 1,600°C, the hottest flame in the mod: Hydrogen and Oxygen in a Firebox Array."],
            x: 6d,
            y: 5d,
            shape: "gear",
            size: 1.5d,
