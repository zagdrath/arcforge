                {
                    type: "xp_levels",
                    levels: 3
                }
            ]
        },
        {
            id: "heat_cells",
            title: "Heat Cells",
            icon: "arcforge:wrought_heat_cell",
            description: [
                "A battery for heat. Wrought (Slag Wool round a copper block): 50,000 HU, 50 HU/t, leaks 10% a minute. Tempered 200,000 HU; Hardened 800,000 HU with Invar Plates and Rock Wool, holding 1,300°C; Arcforged 3,200,000 HU at 1,400°C, 0.5% leak. Each upgrades the one before and keeps its heat.",
                "",
                "**Covers:** {item:arcforge:wrought_heat_cell}, {item:arcforge:tempered_heat_cell}, {item:arcforge:hardened_heat_cell}, {item:arcforge:arcforged_heat_cell}"
            ],
            x: 3d,
            y: 0d,
            dependencies: ["heat_upgrades"],
            tasks: [
