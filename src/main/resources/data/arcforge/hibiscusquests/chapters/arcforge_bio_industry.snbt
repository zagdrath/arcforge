{
    id: "arcforge_bio_industry",
    group: "arcforge_agriculture",
    order: 14,
    title: "Bio-Industry",
    subtitle: "Fermenting, biofuels, greenhouses and rubber",
    icon: "arcforge:fermenter",
    default_shape: "circle",
    quests: [
        {
            id: "fermenter",
            title: "Fermenter",
            icon: "arcforge:fermenter",
            description: [
                "Tempered Alloy, plastic, glass, a cauldron and steel plates. A crop and 100 mB of water ferment into Ethanol (20 to 80 mB; Sorghum is best) for 10 FE/t, giving off Carbon Dioxide. Slimeball, sugar and kelp make a slime culture. Ethanol burns at 900°C, runs the Gas Turbine, makes Biodiesel and Ethylene.",
                "",
                "**Covers:** {item:arcforge:fermenter}, {item:arcforge:ethanol_bucket}"
            ],
            x: 0d,
            y: 1.25d,
            shape: "hexagon",
            size: 1.5d,
            dependencies: ["arcforge_steelmaking/tempered_alloy"],
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "arcforge:machine_produced",
                        conditions: {
                            fluid: "arcforge:ethanol"
                        }
                    },
                    title: "Ferment Ethanol",
                    icon: "arcforge:ethanol_bucket"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:sorghum_seeds",
                    count: 16
                },
                {
                    type: "xp_levels",
                    levels: 5
                }
            ]
        },
        {
            id: "air_separator",
            title: "Air Separator",
            icon: "arcforge:air_separator",
            description: [
                "Tempered Alloy, iron bars, nickel gears, a Wrought Fluid Tank: it pulls 80 Nitrogen and 20 Oxygen out of the air every two seconds for 80 FE/t (not in the End). Nitrogen is half of Ammonia; the Oxygen runs oxy-fuel burners.",
                "",
                "**Covers:** {item:arcforge:air_separator}"
            ],
            x: 0d,
            y: 2.5d,
            dependencies: ["arcforge_steelmaking/tempered_alloy"],
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "arcforge:machine_produced",
                        conditions: {
                            fluid: "arcforge:nitrogen"
                        }
                    },
                    title: "Separate Nitrogen",
                    icon: "arcforge:air_separator"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:nickel_gear",
                    count: 4
                },
                {
                    type: "xp_levels",
                    levels: 5
                }
            ]
        },
        {
            id: "haber",
            title: "Haber Reactor",
            icon: "arcforge:haber_reactor",
            description: [
                "Invar plates, a thermocouple, nickel rods and a Wrought Fluid Tank. 60 Hydrogen and 20 Nitrogen at 450°C become 40 Ammonia a second for 60 FE/t. Ammonia makes NPK Fertilizer and precipitates uranium.",
                "",
                "**Covers:** {item:arcforge:haber_reactor}"
            ],
            x: 1.5d,
            y: 5d,
            shape: "hexagon",
            size: 1.5d,
            dependencies: ["air_separator"],
