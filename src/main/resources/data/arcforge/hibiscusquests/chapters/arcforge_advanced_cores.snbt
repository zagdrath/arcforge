{
    id: "arcforge_advanced_cores",
    group: "arcforge_nuclear",
    order: 19,
    title: "Advanced Cores",
    subtitle: "Lead-bismuth fast reactors and molten salt",
    icon: "arcforge:lead_bismuth_ingot",
    default_shape: "circle",
    quests: [
        {
            id: "lead_bismuth",
            title: "Lead-Bismuth",
            icon: "arcforge:lead_bismuth_ingot",
            description: [
                "Two Lead and two Bismuth Ingots smelted together in the Arcforge Furnace make four Lead-Bismuth Ingots; melt them in the Arc Melter for Lead-Bismuth Eutectic. It freezes below 125°C, so keep the core warm.",
                "",
                "**Covers:** {item:arcforge:lead_bismuth_ingot}"
            ],
            x: 0d,
            y: 0d,
            dependencies: ["arcforge_nuclear_power/fission_reactor"],
            tasks: [
                {
                    type: "item",
                    item: "arcforge:lead_bismuth_ingot"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:bismuth_ingot",
                    count: 8
                },
                {
                    type: "xp_levels",
                    levels: 6
                }
            ]
        },
        {
            id: "fast_reactor",
            title: "Fast Reactor",
            icon: "arcforge:lead_bismuth_ingot",
            description: [
                "Fill the vessel with Lead-Bismuth Eutectic instead of water and leave out the graphite, so the neutrons stay fast. Fuel it with 15 to 20% enriched rods or MOX, with Thorium Blanket Rods round the edge to breed. It runs at 900°C and more at low pressure; hot lead-bismuth goes to a Steam Generator for Superheated Steam."
            ],
            x: 1.5d,
            y: 0d,
            shape: "hexagon",
            size: 1.5d,
            dependencies: ["lead_bismuth"],
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "arcforge:machine_produced",
                        conditions: {
                            recipe_category: "fast_reactor"
                        }
                    },
                    title: "Run a lead-bismuth fast reactor at power",
                    icon: "arcforge:reactor_controller"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:arcforged_alloy",
                    count: 4
                },
                {
                    type: "xp_levels",
                    levels: 20
                }
            ]
        },
        {
            id: "fluoride_salts",
            title: "Fluoride Salts",
            icon: "arcforge:lithium_fluoride",
            description: [
                "Lithium Hydroxide and Hydrofluoric Acid make Lithium Fluoride; Thorium Dioxide and Hydrofluoric Acid make Thorium Tetrafluoride. Both in the Chemical Reactor.",
                "",
                "**Covers:** {item:arcforge:lithium_fluoride}, {item:arcforge:thorium_tetrafluoride}"
            ],
            x: 0d,
            y: 1.25d,
            dependencies: ["arcforge_fuel_cycle/thorium", "arcforge_nuclear_power/fission_reactor"],
            tasks: [
                {
                    type: "item",
                    item: "arcforge:lithium_fluoride"
                },
                {
                    type: "item",
                    item: "arcforge:thorium_tetrafluoride"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:lithium_hydroxide",
                    count: 8
                },
                {
                    type: "xp_levels",
                    levels: 8
                }
            ]
        },
        {
            id: "fuel_salt",
            title: "Fuel Salt",
            icon: "arcforge:thorium_tetrafluoride",
            description: [
                "One Uranium Tetrafluoride (its enrichment carried in), four Lithium Fluoride and two Thorium Tetrafluoride give 1,000 mB of Fuel Salt in the Chemical Reactor."
            ],
            x: 1.5d,
            y: 1.25d,
            dependencies: ["fluoride_salts"],
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "arcforge:machine_produced",
