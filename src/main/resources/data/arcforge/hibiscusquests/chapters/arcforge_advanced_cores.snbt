                    type: "item",
                    item: "arcforge:lithium_fluoride",
                    count: 8
                },
                {
                    type: "xp_levels",
                    levels: 8
                }
            ]
        },
        {
            id: "freeze_plug",
            title: "Freeze Plug",
            icon: "arcforge:freeze_plug",
            description: [
                "A Freeze Plug (nickel plates, Steel Pipe and packed ice) under the vessel's floor, a Drain Tank under it. Powered and cool, the plug stays frozen; if the salt overheats or the power goes, it melts and the salt drains into the shielded tank, and the core shuts down by itself.",
                "",
                "**Covers:** {item:arcforge:freeze_plug}, {item:arcforge:drain_tank}"
            ],
            x: 3d,
            y: 1.25d,
            dependencies: ["fuel_salt"],
            tasks: [
                {
                    type: "item",
                    item: "arcforge:freeze_plug"
                },
                {
                    type: "item",
                    item: "arcforge:drain_tank"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "minecraft:packed_ice",
                    count: 8
                },
                {
                    type: "xp_levels",
                    levels: 8
                }
            ]
        },
        {
            id: "salt_processing",
            title: "Online Cleanup",
            icon: "arcforge:salt_processing_unit",
            description: [
                "Fission products build up in the salt. Salt Processing Units (a Chemical Reactor in steel and pipe) touching the vessel take them out while it runs, using FE, as High-Level Liquid Waste.",
                "",
                "**Covers:** {item:arcforge:salt_processing_unit}"
            ],
            x: 3d,
            y: 2.5d,
            dependencies: ["fuel_salt"],
            tasks: [
                {
                    type: "item",
                    item: "arcforge:salt_processing_unit"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:steel_pipe",
                    count: 8
                },
                {
                    type: "xp_levels",
                    levels: 8
                }
            ]
        },
        {
            id: "molten_salt_reactor",
            title: "Molten Salt Reactor",
            icon: "arcforge:salt_processing_unit",
            description: [
                "Only Control Rod Channels go in a salt core: build enough of them, in graphite, to hold it subcritical with every rod in before you fill it (about one channel in three). It runs at about 700°C; hot Fuel Salt goes to a Steam Generator for High-Pressure Steam."
            ],
            x: 4.5d,
            y: 1.25d,
            shape: "hexagon",
            size: 1.5d,
            dependencies: ["freeze_plug"],
            tasks: [
