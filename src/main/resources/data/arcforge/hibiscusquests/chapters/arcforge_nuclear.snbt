        },
        {
            id: "geiger",
            title: "Geiger Counter",
            icon: "arcforge:geiger_counter",
            description: [
                "Steel plates, a glass pane, redstone and copper. Held, it shows the dose rate in mSv/h and clicks faster near sources. The Dosimeter (glass pane, redstone, Steel Plate) keeps a running total of your dose and warns at each threshold.",
                "",
                "**Covers:** {item:arcforge:geiger_counter}, {item:arcforge:dosimeter}"
            ],
            x: 1.5d,
            y: 2.5d,
            dependencies: ["uraninite"],
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "minecraft:inventory_changed",
                        conditions: {
                            items: [
                                {
                                    items: ["arcforge:geiger_counter", "arcforge:dosimeter"]
                                }
                            ]
                        }
                    },
                    title: "Obtain Geiger Counter or Dosimeter",
                    icon: "arcforge:geiger_counter"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:dosimeter"
                },
                {
                    type: "xp_levels",
                    levels: 4
                }
            ]
        },
        {
            id: "lead",
            title: "Lead",
            icon: "arcforge:lead_ingot",
            description: [
