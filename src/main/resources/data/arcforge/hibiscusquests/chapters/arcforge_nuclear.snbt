                "",
                "**Covers:** {item:arcforge:galena_ore}, {item:arcforge:deepslate_galena_ore}, {item:arcforge:raw_galena}, {item:arcforge:raw_galena_block}, {item:arcforge:lead_dust}, {item:arcforge:lead_ingot}, {item:arcforge:lead_block}, {item:arcforge:lead_plate}"
