    quests: [
        {
            id: "uraninite",
            title: "Uraninite",
            icon: "arcforge:raw_uraninite",
            description: [
                "Uraninite Ore is rare (two veins of four, Y -64..24) and radioactive: Raw Uraninite gives 0.1 mSv/h in your pocket, a block of nine 0.9. It never smelts; an Arc Crusher makes Uraninite Dust (two per ore, four in the array).",
                "",
                "**Covers:** {item:arcforge:uraninite_ore}, {item:arcforge:deepslate_uraninite_ore}, {item:arcforge:raw_uraninite}, {item:arcforge:raw_uraninite_block}, {item:arcforge:uraninite_dust}"
            ],
            x: 0d,
            y: 2.5d,
            shape: "hexagon",
            size: 1.5d,
            tasks: [
                {
                    type: "item",
                    item: "arcforge:raw_uraninite"
                }
            ],
            rewards: [
                {
                    type: "item",
