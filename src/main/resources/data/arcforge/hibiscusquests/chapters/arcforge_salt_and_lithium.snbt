    quests: [
        {
            id: "rock_salt",
            title: "Rock Salt",
            icon: "arcforge:rock_salt",
            description: [
                "Halite Ore lies in flat beds between Y -32 and 40, one bed in four chunks, thicker under deserts and oceans. It drops Rock Salt, which doesn't smelt: an Arc Crusher turns one into two Salt (four in the array). Nine Rock Salt pack into a block.",
                "",
                "**Covers:** {item:arcforge:halite_ore}, {item:arcforge:deepslate_halite_ore}, {item:arcforge:rock_salt}, {item:arcforge:raw_rock_salt_block}"
            ],
            x: 0d,
            y: 0d,
            dependencies: ["arcforge_steelmaking/tempered_alloy"],
            tasks: [
                {
