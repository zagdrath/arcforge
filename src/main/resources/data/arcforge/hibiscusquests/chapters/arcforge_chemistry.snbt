    quests: [
        {
            id: "electrolyzer",
            title: "Electrolyzer",
            icon: "arcforge:electrolyzer",
            description: [
                "Tempered Alloy, glass, nickel plates and a Wrought Fluid Tank. Water splits into 2 Hydrogen and 1 Oxygen for at least 1,416 FE per mB of water, so hydrogen is a battery, never free power. It also splits Brine (Hydrogen, Chlorine, Lye) and Hydrofluoric Acid (Hydrogen, Fluorine).",
                "",
                "**Covers:** {item:arcforge:electrolyzer}"
            ],
            x: 0d,
            y: 1.25d,
            shape: "hexagon",
            size: 1.5d,
            dependencies: ["arcforge_steelmaking/hardened_alloy"],
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "arcforge:machine_produced",
                        conditions: {
                            fluid: "arcforge:hydrogen"
                        }
                    },
                    title: "Make Hydrogen",
                    icon: "arcforge:electrolyzer"
                },
                {
                    type: "criterion",
