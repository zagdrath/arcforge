                "",
                "**Covers:** {item:arcforge:iron_slurry_bucket}, {item:arcforge:copper_slurry_bucket}, {item:arcforge:gold_slurry_bucket}, {item:arcforge:silver_slurry_bucket}, {item:arcforge:nickel_slurry_bucket}, {item:arcforge:tungsten_slurry_bucket}, {item:arcforge:bismuth_slurry_bucket}, {item:arcforge:lead_slurry_bucket}"
