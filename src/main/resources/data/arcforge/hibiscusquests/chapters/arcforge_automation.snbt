    quests: [
        {
            id: "block_breaker",
            title: "Block Breaker",
            icon: "arcforge:block_breaker",
            description: [
                "Wrought Alloy, an iron pickaxe, a Steel Plate and redstone. It breaks the block in front of it for 40 FE/t, as slowly as the block is hard, with a Pulse redstone mode. Point it at a cobblestone generator or a Tree Cutter's trunk.",
                "",
                "**Covers:** {item:arcforge:block_breaker}"
            ],
            x: 0d,
            y: 0d,
            dependencies: ["arcforge_getting_started/powered_up"],
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "minecraft:placed_block",
                        conditions: {
                            location: {
                                type: "minecraft:location_check",
                                predicate: {
                                    block: {
                                        blocks: "arcforge:block_breaker"
                                    }
                                }
                            }
                        }
                    },
                    title: "Place Block Breaker",
                    icon: "arcforge:block_breaker"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "minecraft:iron_pickaxe"
                },
                {
                    type: "xp_levels",
                    levels: 3
                }
            ]
        },
        {
            id: "block_placer",
            title: "Block Placer",
            icon: "arcforge:block_placer",
            description: [
                "Wrought Alloy, a dispenser, a Steel Plate and redstone: it places blocks from its nine slots in front of it for 20 FE each.",
                "",
                "**Covers:** {item:arcforge:block_placer}"
            ],
            x: 0d,
            y: 1.25d,
            dependencies: ["arcforge_getting_started/powered_up"],
            tasks: [
                {
