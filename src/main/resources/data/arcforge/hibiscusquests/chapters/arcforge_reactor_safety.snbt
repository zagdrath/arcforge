                    levels: 6
                }
            ]
        },
        {
            id: "what_remains",
            title: "What Remains",
            icon: "arcforge:solidified_corium",
            description: [
                "Corium slowly cools, faster beside water, into Solidified Corium: still intensely radioactive. Hold a piece of it. Use a Lead Box.",
                "",
                "**Covers:** {item:arcforge:solidified_corium}"
            ],
            x: 3d,
            y: 3.75d,
            shape: "gear",
