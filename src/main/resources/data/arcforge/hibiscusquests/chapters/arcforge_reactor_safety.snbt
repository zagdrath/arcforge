                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:zircon_dust",
                    count: 8
                },
                {
                    type: "xp_levels",
                    levels: 6
                }
            ]
        },
        {
            id: "decontamination",
            title: "Decontamination",
            icon: "arcforge:decontamination_shower",
            description: [
                "A failure without a sealed containment releases Fallout that settles like snow and spreads downwind. Mount a Decontamination Shower overhead: it washes players two blocks below it, and what they carry, using water and wearing out its HEPA Filter (steel rods, paper and wool). Used filters are low-level waste.",
                "",
                "**Covers:** {item:arcforge:decontamination_shower}, {item:arcforge:hepa_filter}, {item:arcforge:used_hepa_filter}"
            ],
            x: 0d,
            y: 3.75d,
            dependencies: ["arcforge_nuclear_power/fission_reactor"],
            tasks: [
