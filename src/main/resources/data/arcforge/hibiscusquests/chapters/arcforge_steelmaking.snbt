        },
        {
            id: "hardened_alloy",
            title: "Hardened Alloy",
            icon: "arcforge:hardened_alloy",
            description: [
                "2 steel + 2 amethyst shards + 1 Nickel Plate + 2 coke at 1,400°C gives 2. Hardened gates the Distillation Array, Superheater, Gas Turbine, Chemical Reactor, Diamond Press and Arc Quarry: most of the mid-game. Nickel Plates come from the Metal Press; amethyst from geodes.",
                "",
                "**Covers:** {item:arcforge:hardened_alloy}"
            ],
            x: 1.5d,
            y: 0d,
            shape: "hexagon",
            size: 1.5d,
