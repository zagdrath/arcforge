                    count: 8
                },
                {
                    type: "xp_levels",
                    levels: 8
                }
            ]
        },
        {
            id: "graphite",
            title: "Graphite",
            icon: "arcforge:graphite",
            description: [
                "Run the furnace up to 1,500°C with one Coal Coke or two Carbon Dust in the metal slot and it comes out as Graphite. Press it into Graphite Anodes for lithium cells, or squeeze four in a Diamond Press into a Diamond. Nine make a Block of Graphite.",
                "",
                "**Covers:** {item:arcforge:graphite}, {item:arcforge:graphite_block}"
            ],
            x: 3d,
            y: 0d,
            dependencies: ["hardened_alloy"],
