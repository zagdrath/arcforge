        {
            id: "tempered_alloy",
            title: "Tempered Alloy",
            icon: "arcforge:tempered_alloy",
            description: [
                "2 steel + 2 copper + 1 coke at 1,300°C gives 2. Tempered is the second tier: every 3×3×3 processing array casing, the Steam Boiler and Turbine, the Electrolyzer, Fermenter, Assembler and Arc Melter are made from it, and every Wrought block upgrades to Tempered by crafting it with Tempered Alloy, keeping its contents.",
                "",
                "**Covers:** {item:arcforge:tempered_alloy}"
            ],
            x: 0d,
            y: 0d,
            shape: "hexagon",
