                    count: 8
                },
                {
                    type: "xp_levels",
                    levels: 5
                }
            ]
        },
        {
            id: "arcforged_alloy",
            title: "Arcforged Alloy",
            icon: "arcforge:arcforged_alloy",
            description: [
                "The top tier: 2 Hardened Alloy + 2 Carbon Fiber + 1 Arcite-Tungsten Composite + 2 coke at 1,500°C gives 2. Carbon Fiber is Pitch from a creosote or crude distillation spun in a Fiberizer; the Composite is a Tungsten Plate with two Arcite Crystals from below Y -40. Arcforged conduits, cells, the Quantum Tunnel and Heat Pipe need it.",
                "",
                "**Covers:** {item:arcforge:arcforged_alloy}, {item:arcforge:carbon_fiber}, {item:arcforge:arcite_tungsten_composite}"
            ],
