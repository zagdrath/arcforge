        {
            id: "mox",
            title: "MOX Fuel",
            icon: "arcforge:mox_fuel_rod",
            description: [
                "Plutonium only ever becomes fuel. Depleted Uranium Dust and Oxygen make Depleted Uranium Dioxide; five Plutonium Oxide and three of it make two MOX Blend. Press it with the Pellet Die, sinter it and rod it in a Zircaloy Tube. MOX rods run like uranium ones, and in the fast reactor.",
                "",
                "**Covers:** {item:arcforge:depleted_uranium_dioxide}, {item:arcforge:mox_blend}, {item:arcforge:green_mox_pellet}, {item:arcforge:mox_fuel_pellet}, {item:arcforge:mox_fuel_rod}"
            ],
            x: 3d,
