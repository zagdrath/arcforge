                    type: "criterion",
                    criterion: {
                        trigger: "arcforge:machine_produced",
                        conditions: {
                            recipe_category: "purex"
                        }
                    },
                    title: "Reprocess a spent rod",
                    icon: "arcforge:plutonium_oxide"
                }
            ],
            rewards: [
                {
                    type: "item",
