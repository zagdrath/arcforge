{
    id: "arcforge_fuel_cycle",
    group: "arcforge_nuclear",
    order: 18,
    title: "Fuel Cycle",
    subtitle: "Spent fuel, PUREX, MOX, thorium and waste",
    icon: "arcforge:purex_controller",
    default_shape: "circle",
    quests: [
        {
            id: "spent_fuel_pool",
            title: "Spent Fuel Pool",
            icon: "arcforge:spent_fuel_rack",
            description: [
                "Spent Fuel Racks (steel rods and plates) hold four rods each and must sit underwater with at least 3 blocks of water above them: the water cools and shields the rods, which glow Cherenkov blue while they're hot. If the pool drains, they heat up and their cladding fails.",
                "",
                "**Covers:** {item:arcforge:spent_fuel_rack}"
            ],
            x: 0d,
            y: 2.5d,
            dependencies: ["arcforge_nuclear_power/fission_reactor"],
            tasks: [
                {
                    type: "item",
                    item: "arcforge:spent_fuel_rack"
                },
                {
                    type: "criterion",
                    criterion: {
                        trigger: "arcforge:machine_produced",
                        conditions: {
                            recipe_category: "spent_fuel_pool"
                        }
                    },
                    title: "Cool spent rods in the pool",
                    icon: "arcforge:spent_fuel_rack"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:steel_plate",
                    count: 16
                },
                {
                    type: "xp_levels",
                    levels: 8
                }
            ]
        },
        {
            id: "dry_cask",
            title: "Dry Cask Storage",
            icon: "arcforge:dry_cask",
            description: [
                "Once a rod's decay heat has fallen (its tooltip shows it), a Dry Cask (Containment Concrete round a Block of Steel) holds seven and shields them anywhere. Broken, it keeps its rods.",
                "",
                "**Covers:** {item:arcforge:dry_cask}"
            ],
            x: 1.5d,
            y: 2.5d,
            dependencies: ["spent_fuel_pool", "arcforge_reactor_safety/containment_materials"],
            tasks: [
                {
                    type: "item",
                    item: "arcforge:dry_cask"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:containment_concrete",
                    count: 8
                },
                {
                    type: "xp_levels",
                    levels: 6
                }
            ]
        },
        {
            id: "nitric_acid",
            title: "Nitric Acid",
            icon: "arcforge:nitric_acid_bucket",
            description: [
                "The Ostwald process in the Chemical Reactor: 100 mB of Ammonia burnt in 200 mB of Oxygen gives Nitrogen Dioxide; 150 mB of it in 50 mB of Water gives 100 mB of Nitric Acid.",
                "",
                "**Covers:** {item:arcforge:nitric_acid_bucket}"
            ],
            x: 0d,
            y: 3.75d,
            dependencies: ["arcforge_nuclear_power/fission_reactor"],
