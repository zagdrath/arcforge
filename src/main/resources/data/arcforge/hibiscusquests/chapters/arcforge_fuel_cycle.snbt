                    count: 2
                },
                {
                    type: "xp_levels",
                    levels: 6
                }
            ]
        },
        {
            id: "hot_cell",
            title: "The Hot Cell",
            icon: "arcforge:hot_cell_casing",
            description: [
                "Hot Cell Casing is steel plates, shielding metal and Containment Concrete; Hot Cell Windows are lead glass. Build an empty box 3 to 9 across and 3 to 6 tall, windows in its walls and the PUREX controller in one.",
                "",
                "**Covers:** {item:arcforge:hot_cell_casing}, {item:arcforge:hot_cell_window}, {item:arcforge:purex_controller}"
