                {
                    type: "xp_levels",
                    levels: 8
                }
            ]
        },
        {
            id: "purex",
            title: "PUREX",
            icon: "arcforge:purex_controller",
            description: [
                "Form the PUREX Plant and feed it spent rods, cooled until their decay heat has fallen. Each is dissolved in 500 mB of Nitric Acid and separated with 100 mB of Kerosene, using 200 FE/t, into Recovered Uranium (back to UF6 and the Cascade), Plutonium Oxide and High-Level Liquid Waste.",
                "",
                "**Covers:** {item:arcforge:recovered_uranium}, {item:arcforge:plutonium_oxide}"
            ],
            x: 1.5d,
            y: 3.75d,
            shape: "hexagon",
            size: 1.5d,
            dependencies: ["hot_cell", "nitric_acid", "spent_fuel_pool"],
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "arcforge:multiblock_formed",
                        conditions: {
                            multiblock: "arcforge:purex_plant"
