        {
            id: "dusts",
            title: "Dust to Dust",
            icon: "arcforge:iron_dust",
            description: [
                "Crush raw iron, copper and gold for Iron, Copper and Gold Dust; quartz for Nether Quartz Dust; coal, charcoal or Bio-Coal for Carbon Dust (a half-coal fuel and a Carbonizer feed that makes coke without creosote); Ancient Debris for Ancient Debris Dust that smelts to netherite scrap. Two Iron Dust and one Nickel Dust craft into three Invar Dust.",
                "",
                "**Covers:** {item:arcforge:iron_dust}, {item:arcforge:copper_dust}, {item:arcforge:gold_dust}, {item:arcforge:carbon_dust}, {item:arcforge:nether_quartz_dust}, {item:arcforge:ancient_debris_dust}, {item:arcforge:silver_dust}, {item:arcforge:nickel_dust}, {item:arcforge:tungsten_dust}, {item:arcforge:fluorite_dust}, {item:arcforge:bismuth_dust}, {item:arcforge:lead_dust}, {item:arcforge:invar_dust}"
            ],
