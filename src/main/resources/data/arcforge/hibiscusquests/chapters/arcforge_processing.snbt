                    levels: 2
                }
            ]
        },
        {
            id: "iolite",
            title: "Iolite",
            icon: "arcforge:iolite_crystal",
            description: [
                "Iolite Ore grows in End Stone (Y 0..80) and drops Iolite Crystals (Fortune works). The crystal is the resonant part of the Link Conduit and Wired Machine Link. Crushing the ore gives two Iolite Dust, which blasts back into a crystal; nine crystals make a Block of Iolite.",
                "",
                "**Covers:** {item:arcforge:iolite_ore}, {item:arcforge:iolite_crystal}, {item:arcforge:iolite_dust}, {item:arcforge:iolite_block}"
            ],
            x: 1.5d,
