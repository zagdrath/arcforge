        {
            id: "arc_crusher",
            title: "The Arc Crusher",
            icon: "arcforge:arc_crusher",
            description: [
                "Steel plates and gears round a grindstone. 20 FE/t: one ore gives two dust plus a 25% bonus, a raw piece one dust and a chance of a second, coal gives Carbon Dust, Slag gives two Basic Slag, cobbled deepslate gives Deepslate Gravel. Dust smelts back to ingots, so crushing doubles your ore.",
                "",
                "**Covers:** {item:arcforge:arc_crusher}"
            ],
            x: 3d,
            y: 1.25d,
            shape: "hexagon",
            size: 1.5d,
            dependencies: ["ingots", "arcforge_getting_started/steel_parts"],
