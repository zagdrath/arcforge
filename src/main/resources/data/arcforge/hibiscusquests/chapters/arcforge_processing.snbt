        {
            id: "sulfur",
            title: "Brimstone",
            icon: "arcforge:sulfur_dust",
            description: [
                "Nether Sulfur Ore (Nether, Y 10..117) drops 2–4 Sulfur Dust; crushing gunpowder gives two, netherrack a chance. Sulfur Dust plus water in a Chemical Reactor is Sulfuric Acid, and the Vulcanizer needs it to cure rubber.",
                "",
                "**Covers:** {item:arcforge:nether_sulfur_ore}, {item:arcforge:sulfur_dust}"
            ],
            x: 1.5d,
            y: 2.5d,
