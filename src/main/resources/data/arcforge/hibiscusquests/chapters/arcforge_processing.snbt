{
    id: "arcforge_processing",
    group: "arcforge_foundations",
    order: 2,
    title: "Ore Processing",
    subtitle: "New ores, crushing, sifting, arrays and parts",
    icon: "arcforge:arc_crusher",
    default_shape: "circle",
    requires: ["arcforge_getting_started/steel_parts"],
    quests: [
        {
            id: "ores",
            title: "New Veins",
            icon: "arcforge:silver_ore",
            description: [
                "Arcforge adds ores to the Overworld: Silver (Y -32..64), Nickel (Y -64..16), Wolframite for tungsten (Y -64..-16), Fluorite (Y -16..48), Bismuth (Y 0..56), Galena for lead (Y -16..64), flat Halite beds, Spodumene for lithium, rare Uraninite, and glowing Arcite deep down (Y -64..-40, diamond pickaxe). Each has a deepslate variant. Dig up a raw piece of five of them.",
                "",
                "**Covers:** {item:arcforge:silver_ore}, {item:arcforge:deepslate_silver_ore}, {item:arcforge:raw_silver}, {item:arcforge:nickel_ore}, {item:arcforge:deepslate_nickel_ore}, {item:arcforge:raw_nickel}, {item:arcforge:wolframite_ore}, {item:arcforge:deepslate_wolframite_ore}, {item:arcforge:raw_wolframite}, {item:arcforge:fluorite_ore}, {item:arcforge:deepslate_fluorite_ore}, {item:arcforge:raw_fluorite}, {item:arcforge:bismuth_ore}, {item:arcforge:deepslate_bismuth_ore}, {item:arcforge:raw_bismuth}"
            ],
            x: 0d,
            y: 1.25d,
            tasks: [
                {
                    type: "item",
