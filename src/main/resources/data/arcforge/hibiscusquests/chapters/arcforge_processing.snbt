                    levels: 3
                }
            ]
        },
        {
            id: "ingots",
            title: "Smelt the New Metals",
            icon: "arcforge:nickel_ingot",
            description: [
                "Raw Silver, Nickel, Bismuth and Wolframite smelt in any furnace to Silver, Nickel, Bismuth and Tungsten Ingots; Raw Fluorite becomes a Fluorite Crystal. Nine of each pack into a storage block, and nine raw pieces into a raw block that an Arc Crusher turns into nine dust.",
                "",
                "**Covers:** {item:arcforge:silver_ingot}, {item:arcforge:silver_block}, {item:arcforge:raw_silver_block}, {item:arcforge:nickel_ingot}, {item:arcforge:nickel_block}, {item:arcforge:raw_nickel_block}, {item:arcforge:tungsten_ingot}, {item:arcforge:tungsten_block}, {item:arcforge:raw_wolframite_block}, {item:arcforge:bismuth_ingot}, {item:arcforge:bismuth_block}, {item:arcforge:raw_bismuth_block}, {item:arcforge:fluorite_crystal}, {item:arcforge:fluorite_block}, {item:arcforge:raw_fluorite_block}"
            ],
            x: 1.5d,
            y: 1.25d,
            dependencies: ["ores"],
            tasks: [
