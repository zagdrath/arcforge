        {
            id: "sifter",
            title: "Sift the Fines",
            icon: "arcforge:sifter",
            description: [
                "The Sifter shakes gravel, sand, Deepslate Gravel and Heavy Mineral Sand through a mesh for dusts, flint, quartz and more. Steel Mesh (8 Steel Rods) is the base: 256 blocks. Invar Mesh gives 1.25× the chances at 1.5× speed; Tungsten Mesh 1.5× and 2× speed, 1,024 blocks. Deepslate Gravel is the only sifted source of tungsten.",
                "",
                "**Covers:** {item:arcforge:sifter}, {item:arcforge:steel_mesh}, {item:arcforge:invar_mesh}, {item:arcforge:tungsten_mesh}, {item:arcforge:deepslate_gravel}"
