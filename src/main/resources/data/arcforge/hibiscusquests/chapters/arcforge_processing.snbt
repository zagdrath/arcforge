        {
            id: "arcite",
            title: "Arcite",
            icon: "arcforge:arcite_crystal",
            description: [
                "Glowing Arcite Ore sits below Y -40 in veins of four and needs a diamond pickaxe. Raw Arcite blasts into an Arcite Crystal (or crushes to Arcite Dust, which blasts to a crystal). Arcite is in every Arcforged recipe: the composite, the top-tier conduits, cells and storage, the Fortune III Module and the Quantum Tunnel. Nine make a glowing block.",
                "",
                "**Covers:** {item:arcforge:arcite_ore}, {item:arcforge:deepslate_arcite_ore}, {item:arcforge:raw_arcite}, {item:arcforge:raw_arcite_block}, {item:arcforge:arcite_dust}, {item:arcforge:arcite_crystal}, {item:arcforge:arcite_block}"
