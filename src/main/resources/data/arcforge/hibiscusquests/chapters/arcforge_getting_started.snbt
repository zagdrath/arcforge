    quests: [
        {
            id: "handbook",
            title: "Read the Manual",
            icon: "arcforge:engineers_handbook",
            description: [
                "The Engineer's Handbook is the reference: every machine, every multiblock with a step-by-step build view, every recipe link (click an item to open JEI). Craft it from a Book and a Copper Ingot and keep it next to your quest book.",
                "",
                "**Covers:** {item:arcforge:engineers_handbook}"
            ],
            x: 0d,
            y: 0d,
            tasks: [
