            ],
            rewards: [
                {
                    type: "item",
                    item: "minecraft:coal",
                    count: 16
                },
                {
                    type: "xp_levels",
                    levels: 2
                }
            ]
        },
        {
            id: "furnace_bricks",
            title: "Firebrick",
            icon: "arcforge:arcforge_furnace_bricks",
            description: [
                "Two bricks and two nether bricks make four Arcforge Furnace Bricks. They line the Firebox, build the Carbonizer and the Arcforge Furnace, and are the heat-proof block in every early recipe.",
                "",
                "**Covers:** {item:arcforge:arcforge_furnace_bricks}"
            ],
            x: 1.5d,
            y: 2.5d,
            dependencies: ["wrench"],
