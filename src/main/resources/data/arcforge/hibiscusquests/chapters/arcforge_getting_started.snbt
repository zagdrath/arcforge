                    type: "xp_levels",
                    levels: 1
                }
            ]
        },
        {
            id: "wrench",
            title: "Turn of the Wrench",
            icon: "arcforge:wrench",
            description: [
                "Three iron and a copper. Sneak-scroll to switch modes: Configure opens side settings, Rotate turns a machine, Port sets a multiblock's ports (every array starts with none), Dismantle picks a machine up with its contents. You'll use it on every structure in this book.",
                "",
                "**Covers:** {item:arcforge:wrench}"
            ],
            x: 0d,
            y: 1.25d,
            tasks: [
                {
                    type: "item",
                    item: "arcforge:wrench"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "minecraft:copper_ingot",
                    count: 8
                },
                {
                    type: "xp_levels",
                    levels: 1
                }
            ]
        },
        {
            id: "combustion_plant",
            title: "Burn Something",
            icon: "arcforge:combustion_plant",
            description: [
                "The Combustion Plant burns coal, charcoal, coal blocks or Bio-Coal straight to FE: 40 FE/t, 32,000 FE per coal. It's the simplest generator and the least efficient. Place one: it needs no steel, so it is your first power, and it will run the Metal Press later in this chapter.",
                "",
                "**Covers:** {item:arcforge:combustion_plant}"
            ],
            x: 1.5d,
            y: 1.25d,
            dependencies: ["wrench"],
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "minecraft:placed_block",
                        conditions: {
                            location: {
                                type: "minecraft:location_check",
                                predicate: {
                                    block: {
                                        blocks: "arcforge:combustion_plant"
                                    }
                                }
                            }
