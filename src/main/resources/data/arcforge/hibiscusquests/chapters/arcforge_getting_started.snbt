        {
            id: "creosote",
            title: "Creosote",
            icon: "arcforge:creosote_bucket",
            description: [
                "250 mB per coal, 100 per log. Creosote burns in a Fuel Burner at 850°C, soaks wood in the Infuser into fireproof treated wood, and is the first feed for a Distillation Array (Naphtha, Light Oil, Heavy Oil and Pitch). Pipe it out or bucket it from the Carbonizer's tank slot.",
                "",
                "**Covers:** {item:arcforge:creosote_bucket}"
            ],
            x: 4.5d,
            y: 3.75d,
            dependencies: ["carbonizer"],
            tasks: [
