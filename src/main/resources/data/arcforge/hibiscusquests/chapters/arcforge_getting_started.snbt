        {
            id: "carbonizer",
            title: "The Carbonizer",
            icon: "arcforge:carbonizer",
            description: [
                "A Carbonizer is a slice 1 wide, 2 to 3 tall and 2 to 3 deep; up to 8 slices side by side share one GUI. It needs no fuel and no power: it bakes coal (600 ticks), Carbon Dust, logs or Bio-Coal into Coal Coke and drips Creosote into its tank. Set an Output port with the Wrench and let it run.",
                "",
                "**Covers:** {item:arcforge:carbonizer}"
            ],
            x: 3d,
            y: 2.5d,
            shape: "hexagon",
            size: 1.5d,
            dependencies: ["furnace_bricks"],
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "arcforge:multiblock_formed",
                        conditions: {
                            multiblock: "arcforge:carbonizer"
                        }
                    },
                    title: "Form the Carbonizer",
                    icon: "arcforge:carbonizer"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "minecraft:coal",
                    count: 32
                },
                {
                    type: "xp_levels",
                    levels: 3
                }
            ]
        },
        {
            id: "coal_coke",
            title: "Coal Coke",
            icon: "arcforge:coal_coke",
            description: [
                "Coke is coal with the tar baked out: it burns hotter (1,300°C, 1.5× a coal in a Firebox Array) and is the reducing agent the Arcforge Furnace needs for every smelt. Nine make a Block of Coal Coke, and a Block of Bio-Coal carbonizes straight into one.",
                "",
                "**Covers:** {item:arcforge:coal_coke}, {item:arcforge:coal_coke_block}"
            ],
            x: 4.5d,
            y: 2.5d,
            dependencies: ["carbonizer"],
            tasks: [
                {
                    type: "item",
