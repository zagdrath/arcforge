                {
                    type: "item",
                    item: "arcforge:carbon_fiber",
                    count: 4
                },
                {
                    type: "xp_levels",
                    levels: 6
                }
            ]
        },
        {
            id: "crude_cuts",
            title: "Crude Cuts",
            icon: "arcforge:diesel_bucket",
            description: [
                "Distil Crude Oil in a 6-tall column or better. Diesel: 1,150°C, 420 FE/mB in a Diesel Generator. Bitumen: the bottoms, for Coker feed and Asphalt. Refinery Gas: a gas fuel and Steam Cracker feed. Build to 10 tall and Kerosene appears: jetpack fuel and the Diesel Generator's lighter cut.",
                "",
                "**Covers:** {item:arcforge:diesel_bucket}, {item:arcforge:bitumen_bucket}, {item:arcforge:kerosene_bucket}"
            ],
            x: 3d,
            y: 3.75d,
