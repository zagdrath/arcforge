{
    id: "arcforge_refinery",
    group: "arcforge_petroleum",
    order: 10,
    title: "Distillation & Refinery",
    subtitle: "Distillation, cracking and refinery units",
    icon: "arcforge:distillation_array_controller",
    default_shape: "circle",
    quests: [
        {
            id: "distillation_parts",
            title: "Column Parts",
            icon: "arcforge:distillation_array_casing",
            description: [
                "Distillation Array Casings are Hardened Alloy, steel plates and a Hardened Fluid Tank. Tray Level Casings (a casing with glass) make the tray layers between top and bottom. The Controller is a casing with a copper gear, steel rods and a redstone block, and sits in an outside face that isn't the top or bottom layer.",
                "",
                "**Covers:** {item:arcforge:distillation_array_casing}, {item:arcforge:tray_level_casing}, {item:arcforge:distillation_array_controller}"
            ],
            x: 0d,
            y: 2.5d,
            dependencies: ["arcforge_steelmaking/tempered_alloy"],
            tasks: [
                {
                    type: "item",
                    item: "arcforge:distillation_array_casing"
                },
                {
                    type: "item",
                    item: "arcforge:tray_level_casing"
                },
                {
                    type: "item",
                    item: "arcforge:distillation_array_controller"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:hardened_fluid_tank"
                },
                {
                    type: "xp_levels",
                    levels: 4
                }
            ]
        },
        {
            id: "distillation_array",
            title: "Distillation Array",
            icon: "arcforge:distillation_array_controller",
            description: [
                "A solid 2×2 or 3×3 column, 4 to 16 tall. Creosote needs 4 layers: Naphtha, Light Oil, Heavy Oil and Pitch. Crude Oil needs 6: Refinery Gas, Naphtha, Diesel, Heavy Oil and Bitumen, with Kerosene and Light Oil from 10 layers and the finest cuts at 14. Throughput scales from 10 mB/t at 2×2×4 to 90 mB/t at 3×3×16."
            ],
            x: 1.5d,
            y: 2.5d,
            shape: "hexagon",
            size: 1.5d,
            dependencies: ["distillation_parts"],
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "arcforge:multiblock_formed",
                        conditions: {
                            multiblock: "arcforge:distillation_array"
                        }
                    },
                    title: "Form the Distillation Array",
                    icon: "arcforge:distillation_array_controller"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:distillation_array_casing",
                    count: 8
                },
                {
                    type: "xp_levels",
                    levels: 8
                }
            ]
        },
        {
            id: "creosote_cuts",
            title: "Creosote Cuts",
            icon: "arcforge:naphtha_bucket",
            description: [
                "Distil Creosote. Naphtha is the hottest liquid burner fuel (1,200°C, makes Superheated Steam) and feeds the Catalytic Reformer and Steam Cracker. Light Oil burns at 1,000°C and, with Hydrogen, becomes Plastic. Heavy Oil lubricates turbines (+8%), feeds the Cracking Unit and Lubricant Blender. Pitch is the solid left over.",
                "",
                "**Covers:** {item:arcforge:naphtha_bucket}, {item:arcforge:light_oil_bucket}, {item:arcforge:heavy_oil_bucket}"
            ],
            x: 3d,
            y: 2.5d,
            dependencies: ["distillation_array"],
            tasks: [
                {
                    type: "criterion",
                    criterion: {
                        trigger: "arcforge:machine_produced",
                        conditions: {
                            fluid: "arcforge:naphtha"
                        }
                    },
                    title: "Distil Naphtha",
                    icon: "arcforge:naphtha_bucket"
                },
                {
                    type: "criterion",
                    criterion: {
                        trigger: "arcforge:machine_produced",
                        conditions: {
                            fluid: "arcforge:light_oil"
                        }
                    },
                    title: "Distil Light Oil",
                    icon: "arcforge:light_oil_bucket"
                },
                {
                    type: "criterion",
                    criterion: {
                        trigger: "arcforge:machine_produced",
                        conditions: {
                            fluid: "arcforge:heavy_oil"
                        }
                    },
                    title: "Distil Heavy Oil",
                    icon: "arcforge:heavy_oil_bucket"
                }
            ],
            rewards: [
                {
                    type: "item",
                    item: "arcforge:naphtha_bucket",
                    count: 2
                },
                {
                    type: "xp_levels",
                    levels: 6
                }
            ]
        },
        {
            id: "pitch",
            title: "Pitch and Carbon Fiber",
            icon: "arcforge:pitch",
            description: [
                "Two Pitch per bucket at 4–5 layers, one when taller. Pitch is a long furnace fuel (12 items), the binder in Asphalt, and in a Fiberizer at 1,000°C it spins into Carbon Fiber: the Arcforged Alloy additive, Turbine Blade Sets and Gas Centrifuge rotors.",
                "",
                "**Covers:** {item:arcforge:pitch}, {item:arcforge:carbon_fiber}"
            ],
            x: 4.5d,
            y: 2.5d,
            shape: "hexagon",
            size: 1.5d,
            dependencies: ["creosote_cuts"],
            tasks: [
                {
                    type: "item",
