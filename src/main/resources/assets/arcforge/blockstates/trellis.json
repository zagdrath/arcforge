{
  "multipart": [
    {
      "apply": {
        "model": "arcforge:block/trellis"
      }
    },
    {
      "when": {
        "age": "1"
      },
      "apply": {
        "model": "arcforge:block/trellis_vine1"
      }
    },
    {
      "when": {
        "age": "2"
      },
      "apply": {
        "model": "arcforge:block/trellis_vine2"
      }
    },
    {
      "when": {
        "age": "3"
      },
      "apply": {
        "model": "arcforge:block/trellis_vine3"
      }
    },
    {
      "when": {
        "age": "4"
      },
      "apply": {
        "model": "arcforge:block/trellis_vine4"
      }
    }
  ]
}
